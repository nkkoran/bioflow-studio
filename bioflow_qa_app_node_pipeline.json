          "script": "set -euo pipefail\nif [ -e \"$OUTPUT\" ]; then\n  echo \"Refusing to overwrite existing output: $OUTPUT\" >&2\n  exit 1\nfi\nmodule load plink/2.00a3.6\nWORK=\"$OUTPUT_DIR/work\"\nmkdir -p \"$WORK\"\nplink2 --vcf \"$INPUT_1\" --double-id --maf 0.01 --make-pgen --out \"$WORK/toy_filtered\"\nplink2 --pfile \"$WORK/toy_filtered\" --pheno \"$INPUT_2\" --pheno-name PHENO --glm hide-covar --out \"$WORK/toy_gwas\"\ncp \"$WORK/toy_gwas.PHENO.glm.linear\" \"$OUTPUT\""
