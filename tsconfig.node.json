{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "outDir": "./out",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "declaration": true,
    "composite": true
  },
  "include": [
    "electron/**/*.ts",
    "src/constants/**/*.ts",
    "src/types/**/*.ts",
    "src/lib/analysisOptions.ts",
    "src/lib/annovarCatalog.ts",
    "src/lib/dataArtifacts.ts",
    "src/lib/fileTypeInference.ts",
    "src/lib/flagRegistry.ts",
    "src/lib/resourceLearning.ts",
    "src/lib/runReadiness.ts",
    "src/lib/runManifest.ts",
    "src/lib/transferPlanner.ts",
    "src/lib/toolRegistry.ts"
  ]
}
